# AlertFlow Configuration
ALERTFLOW_DB=/data/alertflow.db

# API Authentication (set to require API key for all endpoints except /api/health)
ALERTFLOW_API_KEY=
# Comma-separated allowed CORS origins (default: *)
ALERTFLOW_CORS_ORIGINS=*

# ThreatPulse Integration
THREATPULSE_URL=https://threatpulse.example.com
THREATPULSE_API_KEY=

# AdminFlow Integration
ADMINFLOW_URL=https://adminflow.example.com
ADMINFLOW_API_KEY=