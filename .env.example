# AlertFlow Environment Configuration
# Copy to .env and fill in values

# ─── Storage ───────────────────────────────────────────────
ALERTFLOW_DB=alertflow.db                # SQLite path (dev)
# ALERTFLOW_MYSQL_URL=mysql://user:pass@localhost:3306/alertflow  # Production

# ─── Authentication ────────────────────────────────────────
ALERTFLOW_API_KEY=                       # Leave empty to disable auth
ALERTFLOW_AUTH_ENABLED=true

# ─── CORS ─────────────────────────────────────────────────
ALERTFLOW_CORS_ORIGINS=*

# ─── Logging ──────────────────────────────────────────────
ALERTFLOW_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
ALERTFLOW_LOG_FORMAT=json                # json | console

# ─── Rate Limiting ────────────────────────────────────────
ALERTFLOW_RATE_LIMIT=60/minute

# ─── Retention ────────────────────────────────────────────
ALERTFLOW_RETENTION_DAYS=0               # 0 = disabled

# ─── Kafka ────────────────────────────────────────────────
ALERTFLOW_KAFKA_ENABLED=false
ALERTFLOW_KAFKA_TOPIC=logsentry-to-alertflow
ALERTFLOW_KAFKA_GROUP=alertflow-consumers
KAFKA_BROKER=kafka:9092

# ─── ThreatPulse (External Incident Dashboard) ────────────
THREATPULSE_URL=https://your-tp-host/threatpulse
THREATPULSE_API_KEY=tp_your_key_here

# ─── AdminFlow (AD Automation) ────────────────────────────
ADMINFLOW_URL=https://your-af-host/adminflow
ADMINFLOW_API_KEY=af_your_key_here

# ─── Augur (n3xusDB Push) ─────────────────────────────────
AUGUR_URL=https://your-augur-host/augur
