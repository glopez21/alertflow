# AlertFlow Docker Environment — clu5t3r deployment
# Copy this to .env on clu5t3r and fill in values

# ── Database ────────────────────────────────────────────────────
ALERTFLOW_DB=/data/alertflow.db

# ── Kafka ───────────────────────────────────────────────────────
KAFKA_BROKER=kafka:9092
ALERTFLOW_KAFKA_TOPIC=logsentry-to-alertflow
ALERTFLOW_KAFKA_GROUP=alertflow-consumers

# ── ThreatPulse ─────────────────────────────────────────────────
# Leave empty to disable outbound webhooks to ThreatPulse
THREATPULSE_URL=http://threat-pulse-frontend-1:8000
THREATPULSE_API_KEY=

# ── Splunk HEC ──────────────────────────────────────────────────
# Leave empty to disable Splunk HEC forwarding
SPLUNK_HEC_URL=http://splunk:8088
SPLUNK_HEC_TOKEN=

# ── Auth ────────────────────────────────────────────────────────
ALERTFLOW_AUTH_ENABLED=false
ALERTFLOW_API_KEY=

# ── Logging ─────────────────────────────────────────────────────
ALERTFLOW_LOG_LEVEL=INFO
